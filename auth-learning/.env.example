# Copy to .env (never commit .env)
DB_NAME=authdb
DB_USER=authuser
DB_PASSWORD=change-me-locally

# Secret used to sign login tokens. Must be at least 32 characters and truly random.
# Anyone who knows it can forge tokens for any user, so never commit it.
# Generate one in PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Or on Mac/Linux/Git Bash:  openssl rand -base64 48
JWT_SECRET=
